{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAP Change Advisory Output",
  "type": "object",
  "required": [
    "change_id",
    "normalized_requirement",
    "open_questions",
    "impact_analysis",
    "compliance_checks",
    "test_cases",
    "implementation_steps",
    "handover_package"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "agent_version": {
          "type": "string"
        },
        "passes_completed": {
          "type": "number"
        }
      }
    },
    "normalized_requirement": {
      "type": "object",
      "description": "Structured requirement after normalization",
      "properties": {
        "title": {
          "type": "string"
        },
        "business_value": {
          "type": "string"
        },
        "scope_clarification": {
          "type": "string"
        },
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": ["requirement", "technical", "timeline", "resource", "dependency", "risk"]
          },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "evidence": {
            "type": "string",
            "description": "Why this question matters"
          }
        }
      }
    },
    "impact_analysis": {
      "type": "object",
      "properties": {
        "risk_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "risk": {
                "type": "string"
              },
              "probability": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "impact": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "risk_score": {
                "type": "number"
              },
              "mitigation_strategy": {
                "type": "string"
              }
            }
          }
        },
        "affected_systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user_impact": {
          "type": "string"
        },
        "performance_considerations": {
          "type": "string"
        }
      }
    },
    "compliance_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_name": {
            "type": "string"
          },
          "framework": {
            "type": "string",
            "enum": ["SAP Best Practices", "Governance", "Security", "Data Protection", "Audit", "Performance"]
          },
          "status": {
            "type": "string",
            "enum": ["compliant", "non_compliant", "requires_review", "not_applicable"]
          },
          "details": {
            "type": "string"
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_result": {
            "type": "string"
          },
          "test_type": {
            "type": "string",
            "enum": ["unit", "integration", "system", "regression", "user_acceptance", "performance"]
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "implementation_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_number": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "responsible_role": {
            "type": "string"
          },
          "duration_hours": {
            "type": "number"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Step numbers this depends on"
          },
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback_plan": {
            "type": "string"
          }
        }
      }
    },
    "handover_package": {
      "type": "object",
      "description": "Ready-to-deliver package",
      "properties": {
        "executive_summary": {
          "type": "string"
        },
        "detailed_advisory": {
          "type": "string"
        },
        "sign_off_checklist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivery_format": {
          "type": "string",
          "enum": ["markdown", "html", "pdf"]
        }
      }
    },
    "agent_notes": {
      "type": "object",
      "properties": {
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicitly stated unknowns"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optimization_notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Changes from pass 1 to pass 2"
        }
      }
    }
  }
}
